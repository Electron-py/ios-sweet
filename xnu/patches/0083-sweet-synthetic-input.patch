+/*
+ * sweeptouch: a gesture sent through the same entry point a driver would
+ * use, so backboardd, UIKit and SpringBoard see nothing synthetic. The
+ * swipe starts 9 px off the bottom edge, inside SWEET_TOUCH_EDGE_PX, so it
+ * carries the edge-tip bit UIKit needs for unlock/home; the tap lands in
+ * the middle of the screen where the dock's centre icon sits.
+ */
+void
+SweetHIDTouch::synthFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDTouch *self = (SweetHIDTouch *)owner;
+	bool swipe = (self->fSynthCycle & 1) == 0;
+	unsigned step = self->fSynthStep;
+	unsigned last = swipe ? 20 : 6;
+
+	if (step == 0) {
+		self->touch(0, true, 540, swipe ? 2390 : 1200);
+	} else if (step <= last) {
+		int y = swipe ? 2390 - (2390 - 700) * (int)step / 20 : 1200;
+		self->touch(0, true, 540, y);
+	} else {
+		self->touch(0, false, 540, swipe ? 700 : 1200);
+		self->fSynthStep = 0;
+		self->fSynthCycle++;
+		unsigned run = (last + 2) * SWEET_SYNTH_TICK_MS;
+		unsigned period = self->fSynthSecs * 1000;
+		sender->setTimeoutMS(period > run ? period - run : SWEET_SYNTH_TICK_MS);
+		return;
+	}
+	self->fSynthStep++;
+	sender->setTimeoutMS(SWEET_SYNTH_TICK_MS);
+}
