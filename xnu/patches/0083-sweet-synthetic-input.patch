+/*
+ * sweethidkey: walk the physical keys. Power comes first (it sleeps the
+ * panel; the next press wakes it again), then volume up and volume down,
+ * so the key plumbing and the wake path both get exercised with no keys
+ * wired up. Press, release, wait out the period, next key.
+ */
+void
+SweetHIDButtons::keySynthFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDButtons *self = (SweetHIDButtons *)owner;
+	static const UInt32 usages[] = {
+		kHIDUsage_Csmr_Power, kHIDUsage_Csmr_VolumeIncrement,
+		kHIDUsage_Csmr_VolumeDecrement,
+	};
+	bool down = (self->fKeySynthStep & 1) == 0;
+
+	if (down) {
+		self->key(usages[(self->fKeySynthStep / 2) % 3], true);
+		self->fKeySynthStep++;
+		sender->setTimeoutMS(150);
+		return;
+	}
+	self->fKeySynthStep++;
+	sender->setTimeoutMS(self->fKeySynthSecs * 1000);
+}
