+/*
+ * FLEUR MT6781: MTK keypad + PMIC power key driver.
+ * Polls the mediatek,kp keypad controller (0x10010000) for volume keys
+ * and reads PMIC (mt6358) pwrkey via pwrap.
+ * Feeds sweet_hid_key() for power (0), vol+ (1), vol- (2), home (3).
+ * Hardware (from Android DT):
+ *   Keypad: mediatek,kp @ 0x10010000, interrupt 0x49 (GIC SPI 73)
+ *   PMIC: mt6358 via pwrap@1000d000, pwrkey interrupt
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+void sweet_fleur_keys_init(void);
+
+/* MTK Keypad controller registers */
+#define KP_BASE         0x10010000u
+#define KP_SIZE         0x1000u
+#define KP_STA          0x00u
+#define KP_MEM1         0x04u
+#define KP_MEM2         0x08u
+#define KP_MEM3         0x0Cu
+#define KP_MEM4         0x10u
+#define KP_DEBOUNCE     0x14u
+#define KP_SEL          0x18u
+#define KP_EN           0x1Cu
+#define KP_RST          0x20u
+
+/* MTK PWRAP registers (for PMIC access) */
+#define PWRAP_BASE      0x1000d000u
+#define PWRAP_SIZE      0x1000u
+#define PWRAP_WACS0     0x0000u
+#define PWRAP_WACS1     0x0004u
+#define PWRAP_WACS2     0x0008u
+#define PWRAP_RDATA     0x000Cu
+#define PWRAP_WACS_VLD  0x0010u
+#define PWRAP_INT_EN    0x0014u
+#define PWRAP_INT_STA   0x0018u
+#define PWRAP_SPI_EN    0x0020u
+#define PWRAP_MAN_EN    0x0024u
+#define PWRAP_MAN_CMD   0x0028u
+#define PWRAP_MAN_RDATA 0x002Cu
+#define PWRAP_DIO_EN    0x0030u
+#define PWRAP_DEW_EN    0x0034u
+#define PWRAP_CIPHER    0x0038u
+#define PWRAP_HARB_HPRIO 0x0100u
+#define PWRAP_HARB_IPRIO 0x0104u
+#define PWRAP_HARB_STA  0x0108u
+
+static struct {
+	vm_offset_t kp;
+	vm_offset_t pwrap;
+	bool started;
+	int state[4]; /* power, vol+, vol-, home */
+} fk;
+static int fk_sleep_chan;
+
+static uint32_t
+fk_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+fk_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+fk_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&fk_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Simple pwrap write (polling) */
+static int
+fk_pwrap_write(uint16_t addr, uint16_t data)
+{
+	uint32_t wacs = (1u << 31) | (0u << 28) | ((addr & 0xFFFF) << 14) | (data & 0xFFFF);
+	fk_wr(fk.pwrap, PWRAP_WACS0, wacs);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (fk_rd(fk.pwrap, PWRAP_WACS_VLD) & 1) {
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+static int
+fk_pwrap_read(uint16_t addr, uint16_t *data)
+{
+	uint32_t wacs = (1u << 31) | (1u << 28) | ((addr & 0xFFFF) << 14);
+	fk_wr(fk.pwrap, PWRAP_WACS0, wacs);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (fk_rd(fk.pwrap, PWRAP_WACS_VLD) & 1) {
+			*data = fk_rd(fk.pwrap, PWRAP_RDATA) & 0xFFFF;
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+static void
+fk_check_pmic_pwrkey(void)
+{
+	/* Placeholder: read PMIC interrupt status for pwrkey via pwrap */
+}
+
+static void
+fk_check_keypad(void)
+{
+	uint32_t sta = fk_rd(fk.kp, KP_STA);
+	if (sta & 1u) {
+		uint8_t keycode = (sta >> 8) & 0xFF;
+		int key = -1;
+		switch (keycode) {
+		case 0x74: key = 0; break; /* power */
+		case 0x11: key = 1; break; /* vol+ */
+		case 0x08: key = 2; break; /* vol- */
+		case 0x73: key = 3; break; /* home */
+		}
+		if (key >= 0 && !fk.state[key]) {
+			fk.state[key] = 1;
+			sweet_hid_key(key, 1);
+			IOLog("SWEET FLEUR KEYS: key %d down (code 0x%02x)\n", key, keycode);
+		}
+	} else {
+		for (int k = 0; k < 4; ++k) {
+			if (fk.state[k]) {
+				fk.state[k] = 0;
+				sweet_hid_key(k, 0);
+				IOLog("SWEET FLEUR KEYS: key %d up\n", k);
+			}
+		}
+	}
+}
+
+static void *
+fk_thread(void *arg)
+{
+	(void)arg;
+
+	printf("SWEET FLEUR KEYS: starting (keypad @%#x, pwrap @%#x)\n",
+	    KP_BASE, PWRAP_BASE);
+
+	fk.kp = ml_io_map(KP_BASE, KP_SIZE);
+	fk.pwrap = ml_io_map(PWRAP_BASE, PWRAP_SIZE);
+	if (!fk.kp || !fk.pwrap) {
+		printf("SWEET FLEUR KEYS: MMIO mapping failed\n");
+		goto out;
+	}
+
+	/* Enable keypad */
+	fk_wr(fk.kp, KP_EN, 1);
+	fk_wr(fk.kp, KP_DEBOUNCE, 0x400);
+	fk_wr(fk.kp, KP_SEL, 0);
+
+	/* Enable pwrap SPI */
+	fk_wr(fk.pwrap, PWRAP_SPI_EN, 1);
+	fk_wr(fk.pwrap, PWRAP_MAN_EN, 0);
+
+	while (1) {
+		fk_check_keypad();
+		fk_check_pmic_pwrkey();
+		fk_wait(20);
+	}
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+	return NULL;
+}
+
+void
+sweet_fleur_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+
+	if (fk.started) {
+		return;
+	}
+	fk.started = true;
+
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET FLEUR KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+
+	kern_return_t kr = kernel_thread_start(fk_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET FLEUR KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
