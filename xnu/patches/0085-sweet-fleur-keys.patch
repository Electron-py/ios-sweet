diff --git a/bsd/dev/sweet_fleur_keys.c b/bsd/dev/sweet_fleur_keys.c
new file mode 100644
index 0000000..8d2cd05
--- /dev/null
+++ b/bsd/dev/sweet_fleur_keys.c
@@ -0,0 +1,398 @@
+/*
+ * FLEUR MT6781: MTK keypad controller driver (power / volume keys).
+ *
+ * Register model taken from the MT6781 Android kernel source
+ * (drivers/input/keyboard/mediatek/kpd.c and mt6781/hal_kpd.c):
+ *
+ *   mediatek,kp @ 0x10010000, IRQ 0x49, clock "kpd" (clk26m, no gate)
+ *     KP_STA       0x00
+ *     KP_MEM1..5   0x04 0x08 0x0c 0x10 0x14   key state, active low
+ *     KP_DEBOUNCE  0x18   (DT mediatek,kpd-key-debounce = 0x400)
+ *     KP_SCAN_TIME 0x1C
+ *     KP_SEL       0x20   double-key select bit
+ *     KP_EN        0x24
+ *
+ * There is no "keycode in KP_STA" register: the controller exposes five
+ * 16-bit state words covering 72 keys (KPD_NUM_KEYS = 72).  Bit 0 means
+ * released, bit 1 means pressed, and hw keycode = (word << 4) | bit --
+ * that is exactly what kpd_keymap_handler() computes.  We poll those
+ * words and diff them, which needs no IRQ and no PMIC access.
+ *
+ * GPIO80 must additionally be muxed to function 1 (KPD) in the gpio
+ * region mode register -- the vendor's gpio_init_default table has
+ * pin 80 mode 1, and no kernel file applies that table for us.
+ * kpdgpiodefault also asks for bias-pull-up <0x66>: adv pull maps that to
+ * R0 = 0, R1 = 1, PUPD = 0 (pull-up) in the iocfg_bm bank.
+ *
+ * No pwrap / PMIC accesses are made here -- the PMIC pwrkey line belongs
+ * to the mt6358 interrupt tree and is deliberately left alone, since
+ * poking pwrap without its init sequence is how you wedge a phone.
+ *
+ * What the vendor driver writes at boot, audited line by line:
+ *
+ *   probe() -> kpd_set_debounce(0x400)          [KP_DEBOUNCE = 0x18]
+ *            -> request_irq()
+ *   kpd_open()                                  -> no-op
+ *   enable_kpd() / kpd_wakeup_src_setting()     -> suspend/resume only
+ *   kpd_double_key_enable()                     -> double-key props only
+ *                                                    (fleur has none)
+ *
+ * i.e. KP_SEL (0x20) and KP_EN (0x24) are *never* written by Android at
+ * boot -- whatever reset/LK left there is what makes the scan work.  We
+ * used to zero KP_SEL and write KP_EN = 1; the touchkeys5 ring then
+ * showed only column 0 readable: hw 0,9,18,27,36,45,54,63 (all 8 rows of
+ * column 0) lighting up together on every press, and column 8 -- which
+ * holds hw 8 (pwrkey) and hw 17 (rstkey = volume up) -- never read once
+ * in 30 presses.  That is what a column-enable mask set to 1 would do.
+ * So: write KP_DEBOUNCE, leave KP_SEL/KP_EN alone, and print every
+ * register before and after so the next ring confirms it.
+ *
+ * Opt-in via boot-arg `sweetkeys`; feeds sweet_hid_key() so backboardd
+ * sees power(0) / vol+(1) / vol-(2) / home(3) exactly like the synthetic
+ * sweethidtest path.  Every raw hw keycode change is logged so the ring
+ * can confirm the mapping against the physical buttons.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_key(int key, int down);
+void sweet_fleur_keys_init(void);
+
+/* MTK keypad controller registers (hal_kpd.h) */
+#define KP_BASE         0x10010000u
+#define KP_SIZE         0x1000u
+#define KP_STA          0x00u
+#define KP_MEM1         0x04u
+#define KP_DEBOUNCE     0x18u
+#define KP_SCAN_TIMING  0x1Cu
+#define KP_SEL          0x20u
+#define KP_EN           0x24u
+#define KP_DEBOUNCE_MASK 0x3FFFu
+#define KPD_NUM_MEMS    5
+#define KPD_NUM_KEYS    72  /* kpd.h: 8 rows x 9 cols, col 8 = special */
+
+/* gpio region mode register for pin p (pinctrl-mt6781.c) */
+#define GPIO_BASE       0x10005000u
+#define GPIO_SIZE       0x1000u
+#define GPIO_MODE(pin)  (0x300u + 0x10u * ((pin) / 8))
+#define GPIO_MODE_SH(pin) (4u * ((pin) % 8))
+
+/* iocfg_bm bank (0x10002800) holds pin 80's pull fields */
+#define IOCFG_BM_BASE   0x10002800u
+#define IOCFG_BM_SIZE   0x200u
+#define BM_PUPD         0x40u   /* bit 0: 0 = pull-up, 1 = pull-down */
+#define BM_R0           0x60u   /* bit 0 */
+#define BM_R1           0x70u   /* bit 0 */
+
+#define KPD_PIN         80u     /* kpdgpiodefault pinmux <0x5001> */
+
+/*
+ * hw keycode -> sweet_hid_key() slot.
+ *   0  = mediatek,kpd-hw-init-map[0] = 0x72 (KEY_VOLUMEDOWN)
+ *   8  = mediatek,kpd-hw-pwrkey (Android disables it in favour of the
+ *        PMIC path, but the SoC matrix position is still this one)
+ *   17 = mediatek,kpd-hw-dl-key0, the third physical button (volume up)
+ * Anything else is logged raw and ignored.
+ */
+#define SWEET_KEY_POWER 0
+#define SWEET_KEY_VOLUP 1
+#define SWEET_KEY_VOLDN 2
+#define SWEET_KEY_HOME  3
+
+static struct {
+	vm_offset_t kp;
+	vm_offset_t gpio;
+	vm_offset_t iocfg;
+	bool started;
+	uint16_t state[KPD_NUM_MEMS];
+	int skey[4]; /* power, vol+, vol-, home */
+} fk;
+static int fk_sleep_chan;
+
+/* The keypad block is 16-bit oriented (readw/writew in hal_kpd.c). */
+static uint16_t
+fk_rd(vm_offset_t base, uint32_t off)
+{
+	uint16_t v = *(volatile uint16_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+fk_wr(vm_offset_t base, uint32_t off, uint16_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint16_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static uint32_t
+fk_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+fk_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+fk_wait(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&fk_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+fk_set(int key, int down)
+{
+	if (key < 0 || key > 3) {
+		return;
+	}
+	if (fk.skey[key] == down) {
+		return;
+	}
+	fk.skey[key] = down;
+	sweet_hid_key(key, down);
+	printf("SWEET FLEUR KEYS: key %d %s\n", key, down ? "down" : "up");
+}
+
+/* GPIO80 -> function 1 (KPD) plus the DT's bias-pull-up <0x66>. */
+static void
+fk_pinmux(void)
+{
+	uint32_t v;
+
+	v = fk_rd32(fk.gpio, GPIO_MODE(KPD_PIN));
+	v &= ~(0xFu << GPIO_MODE_SH(KPD_PIN));
+	v |= 1u << GPIO_MODE_SH(KPD_PIN);
+	fk_wr32(fk.gpio, GPIO_MODE(KPD_PIN), v);
+
+	v = fk_rd32(fk.iocfg, BM_PUPD);
+	v &= ~(1u << 0);        /* PUPD = 0 -> pull-up */
+	fk_wr32(fk.iocfg, BM_PUPD, v);
+	v = fk_rd32(fk.iocfg, BM_R0);
+	v &= ~(1u << 0);        /* R0 = 0 */
+	fk_wr32(fk.iocfg, BM_R0, v);
+	v = fk_rd32(fk.iocfg, BM_R1);
+	v |= (1u << 0);         /* R1 = 1 */
+	fk_wr32(fk.iocfg, BM_R1, v);
+
+	printf("SWEET FLEUR KEYS: mode80=0x%x pupd=0x%x r0=0x%x r1=0x%x\n",
+	    (fk_rd32(fk.gpio, GPIO_MODE(KPD_PIN)) >> GPIO_MODE_SH(KPD_PIN)) &
+	    0xF, fk_rd32(fk.iocfg, BM_PUPD), fk_rd32(fk.iocfg, BM_R0),
+	    fk_rd32(fk.iocfg, BM_R1));
+}
+
+static void
+fk_get_state(uint16_t *state)
+{
+	unsigned i;
+
+	for (i = 0; i < KPD_NUM_MEMS; ++i) {
+		state[i] = fk_rd(fk.kp, KP_MEM1 + 4u * i);
+	}
+}
+
+/* key slot for a hw keycode, or -1 for "log only". */
+static int
+fk_slot(unsigned hw)
+{
+	switch (hw) {
+	case 0:  return SWEET_KEY_VOLDN;
+	case 8:  return SWEET_KEY_POWER;
+	case 17: return SWEET_KEY_VOLUP;
+	default: return -1;
+	}
+}
+
+/*
+ * One line listing every hw keycode currently held.  A scan that does not
+ * resolve rows prints a whole column at once (e.g. "0 9 18 27 36 45 54 63
+ * "), which is exactly the signature we are hunting, so make it obvious.
+ */
+static void
+fk_summary(const uint16_t *st)
+{
+	char buf[176];
+	int n = 0;
+	unsigned i, j, cnt = 0;
+
+	buf[0] = '\0';
+	for (i = 0; i < KPD_NUM_MEMS; ++i) {
+		for (j = 0; j < 16; ++j) {
+			unsigned hw = (i << 4) + j;
+
+			if (hw >= KPD_NUM_KEYS) {
+				break;
+			}
+			/* bit == 0 means pressed (kpd_keymap_handler) */
+			if ((st[i] & (1u << j)) != 0) {
+				continue;
+			}
+			++cnt;
+			if (n < (int)sizeof(buf) - 10) {
+				n += snprintf(buf + n, sizeof(buf) - n,
+				    "%u(r%u/c%u) ", hw, hw / 9u, hw % 9u);
+			}
+		}
+	}
+	if (cnt != 0) {
+		printf("SWEET FLEUR KEYS: down[%u]: %s\n", cnt, buf);
+	}
+}
+
+static void
+fk_poll(void)
+{
+	uint16_t new_state[KPD_NUM_MEMS];
+	unsigned i, j;
+	bool changed = false;
+
+	fk_get_state(new_state);
+	for (i = 0; i < KPD_NUM_MEMS; ++i) {
+		uint16_t change = new_state[i] ^ fk.state[i];
+
+		if (change == 0) {
+			continue;
+		}
+		changed = true;
+		for (j = 0; j < 16; ++j) {
+			uint16_t mask = (uint16_t)(1u << j);
+			unsigned hw = (i << 4) + j;
+			int pressed, slot;
+
+			if ((change & mask) == 0) {
+				continue;
+			}
+			/* bit == 0 means pressed (kpd_keymap_handler) */
+			pressed = ((new_state[i] & mask) == 0) ? 1 : 0;
+			slot = fk_slot(hw);
+			if (slot >= 0) {
+				fk_set(slot, pressed);
+			}
+			printf("SWEET FLEUR KEYS: hw %u r%u/c%u %s (mem%u=0x%04x "
+			    "%s)\n", hw, hw / 9u, hw % 9u,
+			    pressed ? "down" : "up", i + 1, new_state[i],
+			    slot >= 0 ? "mapped" : "raw");
+		}
+	}
+	if (changed) {
+		fk_summary(new_state);
+	}
+	for (i = 0; i < KPD_NUM_MEMS; ++i) {
+		fk.state[i] = new_state[i];
+	}
+}
+
+static void
+fk_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	printf("SWEET FLEUR KEYS: starting (mediatek,kp @0x%08x)\n", KP_BASE);
+
+	fk.kp = ml_io_map(KP_BASE, KP_SIZE);
+	fk.gpio = ml_io_map(GPIO_BASE, GPIO_SIZE);
+	fk.iocfg = ml_io_map(IOCFG_BM_BASE, IOCFG_BM_SIZE);
+	if (fk.kp == 0 || fk.gpio == 0 || fk.iocfg == 0) {
+		printf("SWEET FLEUR KEYS: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SWEET FLEUR KEYS: kp @0x%llx gpio @0x%llx iocfg @0x%llx\n",
+	    (unsigned long long)fk.kp, (unsigned long long)fk.gpio,
+	    (unsigned long long)fk.iocfg);
+	if (((fk.kp | fk.gpio | fk.iocfg) >> 48) != 0xffffULL) {
+		printf("SWEET FLEUR KEYS: mapping is not a kernel address, "
+		    "leaving the hardware alone\n");
+		goto out;
+	}
+
+	fk_pinmux();
+
+	/*
+	 * Read everything first.  Android's only boot-time write here is
+	 * KP_DEBOUNCE; KP_SEL and KP_EN are deliberately left alone (see
+	 * the file header).  Both dumps are printed so the ring shows what
+	 * reset/LK had configured, and whether our one write changed
+	 * anything other than the debounce counter.
+	 */
+	printf("SWEET FLEUR KEYS: before sta=0x%04x sel=0x%04x scan=0x%04x "
+	    "en=0x%04x deb=0x%04x mem=0x%04x 0x%04x 0x%04x 0x%04x 0x%04x\n",
+	    fk_rd(fk.kp, KP_STA), fk_rd(fk.kp, KP_SEL),
+	    fk_rd(fk.kp, KP_SCAN_TIMING), fk_rd(fk.kp, KP_EN),
+	    fk_rd(fk.kp, KP_DEBOUNCE), fk_rd(fk.kp, KP_MEM1),
+	    fk_rd(fk.kp, KP_MEM1 + 4), fk_rd(fk.kp, KP_MEM1 + 8),
+	    fk_rd(fk.kp, KP_MEM1 + 12), fk_rd(fk.kp, KP_MEM1 + 16));
+
+	fk_wr(fk.kp, KP_DEBOUNCE, (uint16_t)(0x400u & KP_DEBOUNCE_MASK));
+
+	/* Only if the block really is off -- never blindly. */
+	if (fk_rd(fk.kp, KP_EN) == 0) {
+		fk_wr(fk.kp, KP_EN, 1);
+		printf("SWEET FLEUR KEYS: KP_EN read 0, wrote 1\n");
+	}
+
+	fk_get_state(fk.state);
+	printf("SWEET FLEUR KEYS: after  sta=0x%04x sel=0x%04x scan=0x%04x "
+	    "en=0x%04x deb=0x%04x mem=0x%04x 0x%04x 0x%04x 0x%04x 0x%04x\n",
+	    fk_rd(fk.kp, KP_STA), fk_rd(fk.kp, KP_SEL),
+	    fk_rd(fk.kp, KP_SCAN_TIMING), fk_rd(fk.kp, KP_EN),
+	    fk_rd(fk.kp, KP_DEBOUNCE), fk.state[0], fk.state[1], fk.state[2],
+	    fk.state[3], fk.state[4]);
+
+	while (1) {
+		fk_poll();
+		/* Fast enough to catch a state that is only briefly right. */
+		fk_wait(5);
+	}
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_fleur_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	kern_return_t kr;
+
+	if (fk.started) {
+		return;
+	}
+	fk.started = true;
+
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET FLEUR KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+
+	kr = kernel_thread_start(fk_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET FLEUR KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
