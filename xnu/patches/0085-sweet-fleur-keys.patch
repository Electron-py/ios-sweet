diff --git a/bsd/dev/sweet_fleur_keys.c b/bsd/dev/sweet_fleur_keys.c
new file mode 100644
index 0000000..6738522
--- /dev/null
+++ b/bsd/dev/sweet_fleur_keys.c
@@ -0,0 +1,179 @@
+/*
+ * FLEUR MT6781: MTK keypad controller driver (volume keys).
+ *
+ * Hardware facts from the Android DTB:
+ *   mediatek,kp @ 0x10010000, IRQ 0x49, clock "kpd"
+ *   mediatek,kpd-key-debounce = 0x400
+ *   mediatek,kpd-sw-pwrkey    = 0x74   (software power key)
+ *   mediatek,kpd-sw-rstkey    = 0x73   (software reset/home key)
+ *   mediatek,kpd-hw-dl-key0   = 0x11   (volume up)
+ *   mediatek,kpd-hw-dl-key2   = 0x08   (volume down)
+ *
+ * The controller is a free-running status register reader: KP_STA bit0 is
+ * set while a key is down and the keycode sits in bits 15:8.  No pwrap /
+ * PMIC accesses are made here -- the PMIC pwrkey line belongs to the
+ * mt6358 interrupt tree and is deliberately left alone, since poking
+ * pwrap without its init sequence is how you wedge a phone.
+ *
+ * Opt-in via boot-arg `sweetkeys`; feeds sweet_hid_key() so backboardd
+ * sees power(0) / vol+(1) / vol-(2) / home(3) exactly like the synthetic
+ * sweethidtest path.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_key(int key, int down);
+void sweet_fleur_keys_init(void);
+
+/* MTK keypad controller registers */
+#define KP_BASE         0x10010000u
+#define KP_SIZE         0x1000u
+#define KP_STA          0x00u
+#define KP_MEM1         0x04u
+#define KP_DEBOUNCE     0x14u
+#define KP_SEL          0x18u
+#define KP_EN           0x1Cu
+
+/* Keycodes as programmed in the DT (see header). */
+#define KEY_POWER       0x74
+#define KEY_HOME        0x73
+#define KEY_VOLUP       0x11
+#define KEY_VOLDN       0x08
+
+static struct {
+	vm_offset_t kp;
+	bool started;
+	int state[4]; /* power, vol+, vol-, home */
+} fk;
+static int fk_sleep_chan;
+
+static uint32_t
+fk_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+fk_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+fk_wait(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&fk_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+fk_set(int key, int down)
+{
+	if (key < 0 || key > 3) {
+		return;
+	}
+	if (fk.state[key] == down) {
+		return;
+	}
+	fk.state[key] = down;
+	sweet_hid_key(key, down);
+	printf("SWEET FLEUR KEYS: key %d %s\n", key, down ? "down" : "up");
+}
+
+static void
+fk_poll(void)
+{
+	uint32_t sta = fk_rd(fk.kp, KP_STA);
+	int key = -1;
+
+	/* KP_STA bit0 = key pressed, keycode in bits 15:8. */
+	if (sta & 1u) {
+		switch ((sta >> 8) & 0xFF) {
+		case KEY_POWER: key = 0; break;
+		case KEY_VOLUP:  key = 1; break;
+		case KEY_VOLDN:  key = 2; break;
+		case KEY_HOME:   key = 3; break;
+		default: break;
+		}
+	}
+
+	if (key >= 0) {
+		fk_set(key, 1);
+	} else {
+		for (int k = 0; k < 4; ++k) {
+			fk_set(k, 0);
+		}
+	}
+}
+
+static void
+fk_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	printf("SWEET FLEUR KEYS: starting (mediatek,kp @0x%08x)\n", KP_BASE);
+
+	fk.kp = ml_io_map(KP_BASE, KP_SIZE);
+	if (fk.kp == 0) {
+		printf("SWEET FLEUR KEYS: MMIO mapping failed\n");
+		goto out;
+	}
+
+	/* Enable the controller with the DT's debounce value.  These three
+	 * writes mirror what the Android kpd driver does at probe time. */
+	fk_wr(fk.kp, KP_DEBOUNCE, 0x400);
+	fk_wr(fk.kp, KP_SEL, 0);
+	fk_wr(fk.kp, KP_EN, 1);
+
+	while (1) {
+		fk_poll();
+		fk_wait(20);
+	}
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_fleur_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	kern_return_t kr;
+
+	if (fk.started) {
+		return;
+	}
+	fk.started = true;
+
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET FLEUR KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+
+	kr = kernel_thread_start(fk_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET FLEUR KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
