+/*
+ * FLEUR MT6781: MTK I2C + FocalTech FTS touch driver.
+ * Reads touch reports over I2C and feeds them through sweet_hid_touch().
+ *
+ * Every register address and bit below comes from the MT6781 Android
+ * kernel source on disk (drivers/i2c/busses/i2c-mtk.c + i2c-mtk.h,
+ * drivers/pinctrl/mediatek/pinctrl-mt6781.c), not from guesswork:
+ *
+ *   - The controller is "mediatek,i2c" with i2c_common `ver = [02]`,
+ *     i.e. the V2 register map (SOFTRESET 0x50, IO_CONFIG 0x34,
+ *     LTIMING 0x2c, CLOCK_DIV 0x48, MCU_INTR 0x40 ...).
+ *   - Clocks: infracfg_ao INFRA1 bit 29 (`infra_imp_iic`) and the
+ *     imp_iic_wrap gate bit 0 (`imp_ap_i2c0`), parented on topckgen
+ *     `i2c_sel` (CLK_CFG_6 bits 25:24).  We force it to 0 = clk26m so
+ *     clk_src is deterministically 26MHz/5 = 5.2MHz.
+ *   - GPIO144/145 must be muxed to function 1 (I2C) in the *gpio*
+ *     region mode registers; mode for pin p lives at
+ *     0x300 + 0x10 * (p/8), 4 bits at 4*(p%8).  Pull-up is the
+ *     iocfg_lm PU register (0x10002240) bits 2/4.
+ *   - Transfers are kept <= 8 bytes so the controller stays in FIFO
+ *     mode (mt_i2c_do_transfer only uses DMA above 8 bytes, and DMA
+ *     needs a physical buffer we do not have).
+ *   - FTS reads are write + repeated-start read (msg_num = 2 in
+ *     fts_read()), i.e. I2C_MASTER_WRRD.
+ *
+ * Everything here is opt-in via boot-arg `sweettouch` and runs on a
+ * dedicated kernel thread started from the UFS probe, exactly like
+ * sweet_touch.c / sweet_keys.c.  A failed I2C transaction only logs
+ * and backs off -- nothing in this file may ever hang the boot.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_fleur_touch_init(void);
+
+/* --- MTK I2C ver-2 register map (i2c-mtk.h enum V2_OFFSET_*) --- */
+#define I2C_BASE                0x11007000u
+#define I2C_SIZE                0x1000u
+#define I2C_DATA_PORT           0x00u
+#define I2C_SLAVE_ADDR          0x04u
+#define I2C_INTR_MASK           0x08u
+#define I2C_INTR_STAT           0x0Cu
+#define I2C_CONTROL             0x10u
+#define I2C_TRANSFER_LEN        0x14u
+#define I2C_TRANSAC_LEN         0x18u
+#define I2C_DELAY_LEN           0x1Cu
+#define I2C_TIMING              0x20u
+#define I2C_START               0x24u
+#define I2C_EXT_CONF            0x28u
+#define I2C_LTIMING             0x2Cu
+#define I2C_HS                  0x30u
+#define I2C_IO_CONFIG           0x34u
+#define I2C_FIFO_ADDR_CLR       0x38u
+#define I2C_MCU_INTR            0x40u
+#define I2C_TRANSFER_LEN_AUX    0x44u
+#define I2C_CLOCK_DIV           0x48u
+#define I2C_HW_TIMEOUT          0x4Cu
+#define I2C_SOFTRESET           0x50u
+#define I2C_DEBUGSTAT           0xE4u
+#define I2C_FIFO_STAT           0xF4u
+
+/* CONTROL bits */
+#define I2C_CTRL_RS             (1u << 1)
+#define I2C_CTRL_CLK_EXT_EN     (1u << 3)
+#define I2C_CTRL_DIR_CHANGE     (1u << 4)
+#define I2C_CTRL_ACKERR_DET_EN  (1u << 5)
+
+/* INTR_STAT bits */
+#define I2C_ST_COMP             (1u << 0)
+#define I2C_ST_ACKERR           (1u << 1)
+#define I2C_ST_HS_NACKERR       (1u << 2)
+#define I2C_ST_ARB_LOST         (1u << 3)
+#define I2C_ST_TIMEOUT          (1u << 5)
+#define I2C_ST_BUS_ERR          (1u << 8)
+#define I2C_INTR_ALL            0x1FFu
+/* int_reg as computed by mt_i2c_do_transfer() for ver == 0x2 */
+#define I2C_INT_MASK            (I2C_ST_COMP | I2C_ST_ACKERR | \
+    I2C_ST_HS_NACKERR | I2C_ST_ARB_LOST | I2C_ST_TIMEOUT | I2C_ST_BUS_ERR)
+#define I2C_BAD_BITS            (I2C_ST_ACKERR | I2C_ST_HS_NACKERR | \
+    I2C_ST_ARB_LOST | I2C_ST_TIMEOUT | I2C_ST_BUS_ERR)
+
+/* Init constants (i2c-mtk.h) */
+#define I2C_SOFT_RST_VAL        0x0001u
+#define I2C_IO_OPEN_DRAIN       0x0003u
+#define I2C_DELAY_LEN_VAL       0x000Au
+#define I2C_TIMEOUT_EN          0x0001u
+#define I2C_MCU_INTR_EN         0x0001u
+#define I2C_EXT_TIME_CONFIG     0x0118u  /* i2c_common ext_time_config */
+#define I2C_CLK_SRC_DIV         5u       /* i2c0 clock-div */
+#define I2C_MAX_FIFO            8u       /* DMA kicks in above this */
+
+/* --- GPIO region: DIR/DOUT/DIN/MODE (pinctrl-mt6781.c _range tables) --- */
+#define GPIO_BASE               0x10005000u
+#define GPIO_SIZE               0x1000u
+#define GPIO_DIR(pin)           (0x000u + 0x10u * ((pin) / 32))
+#define GPIO_DIR_SET(pin)       (GPIO_DIR(pin) + 0x04u)
+#define GPIO_DIR_CLR(pin)       (GPIO_DIR(pin) + 0x08u)
+#define GPIO_DOUT(pin)          (0x100u + 0x10u * ((pin) / 32))
+#define GPIO_DOUT_SET(pin)      (GPIO_DOUT(pin) + 0x04u)
+#define GPIO_DOUT_CLR(pin)      (GPIO_DOUT(pin) + 0x08u)
+#define GPIO_DIN(pin)           (0x200u + 0x10u * ((pin) / 32))
+#define GPIO_MODE(pin)          (0x300u + 0x10u * ((pin) / 8))
+#define GPIO_MODE_SH(pin)       (4u * ((pin) % 8))
+
+/* --- clock gating / pinmux bases --- */
+/*
+ * Clock gates: bit set = clock OFF, bit cleared = clock ON.
+ * (clk-gate.c: mtk_cg_is_enabled() returns mtk_cg_bit_is_cleared(); the
+ * enable path writes clr_ofs, the disable path writes set_ofs.)
+ */
+#define INFRACFG_BASE           0x10001000u
+#define INFRA1_CG_SET           0x88u   /* write 1 = gate = clock OFF */
+#define INFRA1_CG_CLR           0x8Cu   /* write 1 = ungate = clock ON */
+#define INFRA1_CG_STA           0x94u   /* infra_imp_iic = INFRA1 bit 29 */
+#define IMP_IIC_BASE            0x11017000u
+#define IMP_CG_SET              0xE08u
+#define IMP_CG_CLR              0xE04u
+#define IMP_CG_STA              0xE00u  /* imp_ap_i2c0 = gate bit 0 */
+#define TOPCK_BASE              0x10000000u
+#define TOP_CLK_CFG_6           0xA0u   /* i2c_sel, bits 25:24 */
+#define TOP_CLK_CFG_6_CLR       0xA8u
+#define TOP_CLK_UPDATE          0x004u  /* update bit 27 */
+#define IOCFG_LM_BASE           0x10002200u  /* pins 144/145 live here */
+#define IOCFG_LM_SIZE           0x200u
+#define IOCFG_PU                0x40u   /* pin144 = bit 2, pin145 = bit 4 */
+#define IOCFG_PD                0x30u
+
+/*
+ * FocalTech FTS registers, frame layout and boot sequence: all from
+ * drivers/input/touchscreen/mediatek/ft3418_i2c/ in the MT6781 Android
+ * kernel (the driver that matches DT compatible = "focaltech,fts").
+ *
+ *   FTS_TOUCH_DATA_LEN  = 10 * FTS_ONE_TCH_LEN + 3   (focaltech_core.h)
+ *   fts_read_touchdata(): buf[0] = 0x01, then 62 data bytes follow, so
+ *   with our buffer (no leading register byte) data byte n == buf[n].
+ *   Vendor index k therefore maps to buf[k - 1]:
+ *     FTS_TOUCH_POINT_NUM 2 -> count at buf[1]
+ *     FTS_TOUCH_EVENT_POS 3 -> point i at buf[2 + 6*i]
+ */
+#define FTS_ADDR        0x38u
+#define FTS_MAX_FINGERS 10u
+#define FTS_POINTS_REG  0x01u
+#define FTS_POINT_LEN   6u
+#define FTS_ID_REG      0xA3u   /* FTS_REG_CHIP_ID  (chip id high) */
+#define FTS_ID_REG2     0x9Fu   /* FTS_REG_CHIP_ID2 (chip id low)  */
+#define FTS_CTRL_REG    0x86u
+#define FTS_MAX_ID      10u     /* id nibble >= this = no such point */
+
+/* event field, buf[base] >> 6 (focaltech_core.h) */
+#define FTS_TOUCH_DOWN      0u
+#define FTS_TOUCH_UP        1u
+#define FTS_TOUCH_CONTACT   2u
+
+/* FTS_CHIP_TYPE_MAPPING for _FT3418: the pair we expect to read back. */
+#define FTS_CHIP_IDH    0x54u
+#define FTS_CHIP_IDL    0x52u
+
+/* fts_hid2std(): written only when the id pair never matches. */
+#define FTS_HID2STD_REG 0xEBu
+
+#define TOUCH_IRQ_GPIO  15
+#define TOUCH_RST_GPIO  16
+#define TOUCH_AVDD_GPIO 58
+
+static struct {
+	vm_offset_t i2c;
+	vm_offset_t gpio;
+	vm_offset_t iocfg;
+	vm_offset_t infracfg;
+	vm_offset_t imp;
+	vm_offset_t topck;
+	bool started;
+	bool dead;
+	bool warned;
+	unsigned polls;
+	uint16_t timing;
+	uint16_t ltiming;
+	/* one-shot failure diagnostics */
+	uint16_t f_stat;
+	uint16_t f_dbg;
+	uint16_t f_fifo;
+	uint16_t f_ctl;
+	unsigned fails;
+	unsigned rawdumps;      /* one-shot dumps of the vendor frame */
+	int x[FTS_MAX_FINGERS];
+	int y[FTS_MAX_FINGERS];
+	bool down[FTS_MAX_FINGERS];
+} ft;
+static int ft_sleep_chan;
+
+/* 32-bit accesses for GPIO / clock / pinctrl blocks (readl/writel). */
+static uint32_t
+ft_rd(vm_offset_t base, vm_offset_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+ft_wr(vm_offset_t base, vm_offset_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* The I2C block is 16-bit oriented: the kernel uses readw/writew. */
+static uint16_t
+ft_rd16(vm_offset_t base, vm_offset_t off)
+{
+	uint16_t v = *(volatile uint16_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+ft_wr16(vm_offset_t base, vm_offset_t off, uint16_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint16_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/*
+ * Sleep `ms` on a wait channel.  Uses the same pattern as the existing
+ * sweet drivers: assert_wait_deadline + thread_block, so the thread is
+ * never spinning in the kernel.
+ */
+static void
+ft_wait(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ft_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+ft_mode(unsigned pin, unsigned mode)
+{
+	uint32_t reg = GPIO_MODE(pin);
+	uint32_t sh = GPIO_MODE_SH(pin);
+	uint32_t v = ft_rd(ft.gpio, reg);
+
+	v &= ~(0xFu << sh);
+	v |= (mode & 0xFu) << sh;
+	ft_wr(ft.gpio, reg, v);
+}
+
+static void
+ft_gpio_dir(unsigned pin, bool out)
+{
+	ft_wr(ft.gpio, out ? GPIO_DIR_SET(pin) : GPIO_DIR_CLR(pin),
+	    1u << (pin % 32));
+}
+
+static void
+ft_gpio_write(unsigned pin, bool high)
+{
+	ft_wr(ft.gpio, high ? GPIO_DOUT_SET(pin) : GPIO_DOUT_CLR(pin),
+	    1u << (pin % 32));
+}
+
+static bool
+ft_gpio_read(unsigned pin)
+{
+	return (ft_rd(ft.gpio, GPIO_DIN(pin)) >> (pin % 32)) & 1u;
+}
+
+/*
+ * Speed setup, ported verbatim from i2c-mtk.c: mtk_i2c_calculate_speed()
+ * with cnt_constraint set (i2c_common cnt_constraint = [01]) and duty 45/55
+ * (DUTY_CYCLE / 100 - DUTY_CYCLE) for set_ltiming.
+ */
+static int
+ft_calc_speed(unsigned clk_src, unsigned speed_hz, unsigned *step,
+    unsigned *sample)
+{
+	unsigned khz = speed_hz / 1000;
+	unsigned hclk = clk_src / 1000;
+	unsigned max_step, sample_div = 8, step_div, min_div, best_mul;
+	unsigned s, st, mul;
+
+	if (speed_hz > 400000u * 8) {
+		max_step = 8;   /* MAX_HS_STEP_CNT_DIV */
+	} else if (speed_hz > 400000u) {
+		max_step = 8;
+	} else {
+		max_step = 64;  /* MAX_STEP_CNT_DIV */
+	}
+	if (khz == 0) {
+		return -1;
+	}
+	min_div = ((hclk >> 1) + khz - 1) / khz;
+	best_mul = 8 * max_step;
+	step_div = max_step;
+	for (s = 1; s <= 8; ++s) {
+		st = (min_div + s - 1) / s;
+		mul = st * s;
+		if (st > max_step) {
+			continue;
+		}
+		if (mul < best_mul) {
+			best_mul = mul;
+			sample_div = s;
+			step_div = st;
+			if (best_mul == min_div) {
+				break;
+			}
+		}
+	}
+	s = sample_div;
+	st = step_div;
+	if (hclk / (2 * s * st) > khz) {
+		return -1;
+	}
+	/* cnt_constraint: --sample_cnt == 0 leaves step_cnt alone */
+	if (--s != 0) {
+		st--;
+	}
+	*step = st;
+	*sample = s;
+	return 0;
+}
+
+static void
+ft_i2c_speed_setup(void)
+{
+	unsigned clk_src = 26000000u / I2C_CLK_SRC_DIV; /* clk26m / 5 */
+	unsigned step = 0, sample = 0, lstep = 0, lsample = 0;
+	unsigned tv, tv1, tv2;
+
+	/* duty = DUTY_CYCLE (45) because 100k < 400k <= FS and set_ltiming */
+	if (ft_calc_speed(clk_src, (400000u * 50u) / 45u, &step, &sample) != 0) {
+		step = 6;
+		sample = 0;
+	}
+	if (ft_calc_speed(clk_src, (400000u * 50u) / 55u, &lstep, &lsample) != 0) {
+		lstep = 8;
+		lsample = 0;
+	}
+	ft.timing = (uint16_t)((sample << 8) | step);
+	ft.ltiming = (uint16_t)((lsample << 6) | lstep);
+
+	/* SCL low timeout register, same formula as mt_i2c_do_transfer() */
+	tv1 = (clk_src / 1000) * 2;            /* MAX_SCL_LOW_TIME = 2 ms */
+	tv2 = (((ft.ltiming & 0x3Fu) + 1) *
+	    (((ft.ltiming & 0x1C0u) >> 6) + 1));
+	tv = tv2 ? ((tv1 + tv2 - 1) / tv2) : 0;
+	ft_wr16(ft.i2c, I2C_HW_TIMEOUT, (uint16_t)(tv & 0xFFFFu));
+
+	/* set_dt_div: ((div - 1) << 8) + (div - 1) */
+	ft_wr16(ft.i2c, I2C_CLOCK_DIV,
+	    (uint16_t)(((I2C_CLK_SRC_DIV - 1) << 8) + (I2C_CLK_SRC_DIV - 1)));
+}
+
+/* mt_i2c_init_hw(), ver 2 / FIFO / open-drain. */
+static void
+ft_i2c_init_hw(void)
+{
+	uint16_t stat;
+
+	ft_wr16(ft.i2c, I2C_INTR_MASK, 0);
+	stat = ft_rd16(ft.i2c, I2C_INTR_STAT);
+	ft_wr16(ft.i2c, I2C_INTR_STAT, stat);
+	ft_wr16(ft.i2c, I2C_SOFTRESET, I2C_SOFT_RST_VAL);
+	ft_wr16(ft.i2c, I2C_IO_CONFIG, I2C_IO_OPEN_DRAIN);
+	ft_i2c_speed_setup();
+	ft_wr16(ft.i2c, I2C_TIMING, (uint16_t)(ft.timing | I2C_TIMEOUT_EN));
+	ft_wr16(ft.i2c, I2C_LTIMING, ft.ltiming);
+	ft_wr16(ft.i2c, I2C_HS, 0);
+	ft_wr16(ft.i2c, I2C_CONTROL,
+	    (uint16_t)(I2C_CTRL_ACKERR_DET_EN | I2C_CTRL_CLK_EXT_EN));
+	ft_wr16(ft.i2c, I2C_EXT_CONF, I2C_EXT_TIME_CONFIG);
+	ft_wr16(ft.i2c, I2C_DELAY_LEN, I2C_DELAY_LEN_VAL);
+}
+
+static void
+ft_note_fail(uint16_t stat)
+{
+	ft.fails++;
+	if (ft.fails == 1 || (ft.fails % 200) == 0) {
+		printf("SWEET FLEUR TOUCH: I2C fail #%u stat=0x%04x "
+		    "ctl=0x%04x dbg=0x%04x fifo=0x%04x (fifo_stat/st)\n",
+		    ft.fails, stat, ft_rd16(ft.i2c, I2C_CONTROL),
+		    ft_rd16(ft.i2c, I2C_DEBUGSTAT),
+		    ft_rd16(ft.i2c, I2C_FIFO_STAT));
+	}
+	ft.f_stat = stat;
+	ft.f_ctl = ft_rd16(ft.i2c, I2C_CONTROL);
+	ft.f_dbg = ft_rd16(ft.i2c, I2C_DEBUGSTAT);
+	ft.f_fifo = ft_rd16(ft.i2c, I2C_FIFO_STAT);
+}
+
+/*
+ * One FIFO transaction.  wlen/rlen are both limited to I2C_MAX_FIFO so the
+ * controller never reaches for DMA.  A read is the FTS write+repeated-start
+ * read (WRRD); a read with no command byte is a plain read.
+ */
+static int
+ft_i2c_xfer(const uint8_t *w, unsigned wlen, uint8_t *r, unsigned rlen)
+{
+	uint16_t ctrl, addr, stat = 0;
+	unsigned i;
+
+	if (wlen > I2C_MAX_FIFO || rlen > I2C_MAX_FIFO) {
+		return -1;
+	}
+	ctrl = I2C_CTRL_ACKERR_DET_EN | I2C_CTRL_CLK_EXT_EN;
+	if (wlen && rlen) {
+		ctrl |= I2C_CTRL_DIR_CHANGE | I2C_CTRL_RS;
+	}
+	addr = (uint16_t)(FTS_ADDR << 1);
+	if (!wlen && rlen) {
+		addr |= 1u;
+	}
+
+	ft_wr16(ft.i2c, I2C_CONTROL, ctrl);
+	ft_wr16(ft.i2c, I2C_EXT_CONF, I2C_EXT_TIME_CONFIG);
+	ft_wr16(ft.i2c, I2C_DELAY_LEN, I2C_DELAY_LEN_VAL);
+	ft_wr16(ft.i2c, I2C_IO_CONFIG, I2C_IO_OPEN_DRAIN);
+	ft_wr16(ft.i2c, I2C_TIMING, (uint16_t)(ft.timing | I2C_TIMEOUT_EN));
+	ft_wr16(ft.i2c, I2C_LTIMING, ft.ltiming);
+	ft_wr16(ft.i2c, I2C_HS, 0);
+	ft_wr16(ft.i2c, I2C_SLAVE_ADDR, addr);
+	ft_wr16(ft.i2c, I2C_INTR_STAT, (uint16_t)I2C_INTR_ALL);
+	ft_wr16(ft.i2c, I2C_FIFO_ADDR_CLR, 1);
+	ft_wr16(ft.i2c, I2C_INTR_MASK, (uint16_t)I2C_INT_MASK);
+
+	if (wlen && rlen) {
+		ft_wr16(ft.i2c, I2C_TRANSFER_LEN, (uint16_t)wlen);
+		ft_wr16(ft.i2c, I2C_TRANSFER_LEN_AUX, (uint16_t)rlen);
+		ft_wr16(ft.i2c, I2C_TRANSAC_LEN, 2);
+	} else {
+		ft_wr16(ft.i2c, I2C_TRANSFER_LEN,
+		    (uint16_t)(wlen ? wlen : rlen));
+		ft_wr16(ft.i2c, I2C_TRANSAC_LEN, 1);
+	}
+
+	for (i = 0; i < wlen; ++i) {
+		ft_wr16(ft.i2c, I2C_DATA_PORT, w[i]);
+	}
+	ft_wr16(ft.i2c, I2C_MCU_INTR, I2C_MCU_INTR_EN);
+	ft_wr16(ft.i2c, I2C_START, 1);
+
+	for (i = 0; i < 40000; ++i) {
+		stat = ft_rd16(ft.i2c, I2C_INTR_STAT);
+		if (stat & I2C_INT_MASK) {
+			break;
+		}
+		delay(1);
+	}
+	if (!(stat & I2C_ST_COMP) || (stat & I2C_BAD_BITS)) {
+		ft_note_fail(stat);
+		ft_wr16(ft.i2c, I2C_INTR_STAT, (uint16_t)I2C_INTR_ALL);
+		return -1;
+	}
+	for (i = 0; i < rlen; ++i) {
+		r[i] = (uint8_t)(ft_rd16(ft.i2c, I2C_DATA_PORT) & 0xFF);
+	}
+	ft_wr16(ft.i2c, I2C_INTR_STAT, (uint16_t)I2C_INTR_ALL);
+	return 0;
+}
+
+/* Chunked read: FIFO mode caps us at 8 bytes per transaction. */
+static int
+ft_i2c_read(uint8_t reg, uint8_t *data, unsigned len)
+{
+	unsigned done = 0;
+
+	while (done < len) {
+		unsigned n = len - done;
+		uint8_t tmp[8];
+
+		if (n > 8) {
+			n = 8;
+		}
+		if (ft_i2c_xfer(&reg, 1, tmp, n) != 0) {
+			return -1;
+		}
+		for (unsigned i = 0; i < n; ++i) {
+			data[done + i] = tmp[i];
+		}
+		done += n;
+		reg = (uint8_t)(reg + n);
+	}
+	return 0;
+}
+
+/* Write-only transfer (fts_write(): first byte is the register address). */
+static int
+ft_i2c_write(const uint8_t *data, unsigned len)
+{
+	return ft_i2c_xfer(data, len, NULL, 0);
+}
+
+static void
+ft_read_points(void)
+{
+	uint8_t buf[2 + FTS_MAX_FINGERS * FTS_POINT_LEN];
+	unsigned i, np;
+
+	if (ft_i2c_read(FTS_POINTS_REG, buf, sizeof(buf)) != 0) {
+		if (!ft.warned) {
+			ft.warned = true;
+			printf("SWEET FLEUR TOUCH: I2C read failed, backing off\n");
+		}
+		return;
+	}
+	ft.warned = false;
+
+	/*
+	 * Vendor frame (ft3418_i2c): buf[1] = point count, then for each
+	 * point i at base = 2 + 6*i:
+	 *   [base+0] event (7:6) | x high (3:0)
+	 *   [base+1] x low
+	 *   [base+2] id (7:4) | y high (3:0)
+	 *   [base+3] y low, [base+4] pressure, [base+5] area
+	 */
+	np = buf[1] & 0x0F;
+
+	if (ft.rawdumps < 3 || (np != 0 && ft.rawdumps < 8)) {
+		ft.rawdumps++;
+		printf("SWEET FLEUR TOUCH: frame cnt=%u raw "
+		    "%02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    np, buf[0], buf[1], buf[2], buf[3],
+		    buf[4], buf[5], buf[6], buf[7]);
+	}
+	if (np > FTS_MAX_FINGERS) {
+		np = FTS_MAX_FINGERS;
+	}
+
+	for (i = 0; i < FTS_MAX_FINGERS; ++i) {
+		bool was = ft.down[i];
+		bool now = false;
+		int x = 0, y = 0;
+		unsigned id = FTS_MAX_ID, ev = FTS_TOUCH_UP;
+
+		if (i < np) {
+			unsigned base = 2 + i * FTS_POINT_LEN;
+
+			id = buf[base + 2] >> 4;
+			ev = buf[base] >> 6;
+			if (id < FTS_MAX_ID) {
+				x = ((buf[base] & 0x0F) << 8) | buf[base + 1];
+				y = ((buf[base + 2] & 0x0F) << 8) |
+				    buf[base + 3];
+				if (x > 1079) {
+					x = 1079;
+				}
+				if (y > 2399) {
+					y = 2399;
+				}
+				/* 0 = down, 2 = contact, 1 = up */
+				now = (ev != FTS_TOUCH_UP);
+			}
+		}
+		if (!was && now) {
+			ft.down[i] = true;
+			ft.x[i] = x;
+			ft.y[i] = y;
+			sweet_hid_touch((int)i, 1, x, y);
+			printf("SWEET FLEUR TOUCH: finger %u id=%u ev=%u down "
+			    "at %d,%d\n", i, id, ev, x, y);
+		} else if (was && !now) {
+			ft.down[i] = false;
+			sweet_hid_touch((int)i, 0, ft.x[i], ft.y[i]);
+			printf("SWEET FLEUR TOUCH: finger %u up (ev=%u)\n",
+			    i, ev);
+		} else if (was && now && (x != ft.x[i] || y != ft.y[i])) {
+			ft.x[i] = x;
+			ft.y[i] = y;
+			sweet_hid_touch((int)i, 1, x, y);
+		}
+	}
+}
+
+/* Enable the I2C clock chain and force i2c_sel onto clk26m. */
+static void
+ft_clocks_on(void)
+{
+	uint32_t sel, before1, before2;
+
+	before1 = ft_rd(ft.infracfg, INFRA1_CG_STA);
+	before2 = ft_rd(ft.imp, IMP_CG_STA);
+	/* CLR = ungate.  Writing to SET would switch the clocks *off*. */
+	ft_wr(ft.infracfg, INFRA1_CG_CLR, 1u << 29);
+	ft_wr(ft.imp, IMP_CG_CLR, 1u << 0);
+
+	sel = (ft_rd(ft.topck, TOP_CLK_CFG_6) >> 24) & 0x3u;
+	if (sel != 0) {
+		/* write-1-to-clear the 2-bit field, then pulse update bit 27 */
+		ft_wr(ft.topck, TOP_CLK_CFG_6_CLR, 0x3u << 24);
+		ft_wr(ft.topck, TOP_CLK_UPDATE, 1u << 27);
+	}
+	printf("SWEET FLEUR TOUCH: cg infra1 0x%08x->0x%08x imp 0x%08x->0x%08x "
+	    "i2c_sel %u->%u\n",
+	    before1, ft_rd(ft.infracfg, INFRA1_CG_STA),
+	    before2, ft_rd(ft.imp, IMP_CG_STA), sel,
+	    (ft_rd(ft.topck, TOP_CLK_CFG_6) >> 24) & 0x3u);
+}
+
+/* Mux GPIO144/145 to I2C (fn 1) and give them pull-ups. */
+static void
+ft_pins_i2c(void)
+{
+	uint32_t v;
+
+	v = ft_rd(ft.gpio, GPIO_MODE(144));
+	v &= ~(0xFu << GPIO_MODE_SH(144));
+	v |= 1u << GPIO_MODE_SH(144);
+	v &= ~(0xFu << GPIO_MODE_SH(145));
+	v |= 1u << GPIO_MODE_SH(145);
+	ft_wr(ft.gpio, GPIO_MODE(144), v);
+
+	v = ft_rd(ft.iocfg, IOCFG_PU);
+	v |= (1u << 2) | (1u << 4);
+	ft_wr(ft.iocfg, IOCFG_PU, v);
+	v = ft_rd(ft.iocfg, IOCFG_PD);
+	v &= ~((1u << 2) | (1u << 4));
+	ft_wr(ft.iocfg, IOCFG_PD, v);
+
+	printf("SWEET FLEUR TOUCH: mode144=0x%08x pu=0x%08x pd=0x%08x\n",
+	    ft_rd(ft.gpio, GPIO_MODE(144)),
+	    ft_rd(ft.iocfg, IOCFG_PU), ft_rd(ft.iocfg, IOCFG_PD));
+}
+
+/* FTS_REG_CHIP_ID (0xA3) = high byte, FTS_REG_CHIP_ID2 (0x9F) = low byte. */
+static int
+ft_read_ids(uint8_t *idh, uint8_t *idl)
+{
+	if (ft_i2c_read(FTS_ID_REG, idh, 1) != 0) {
+		return -1;
+	}
+	return ft_i2c_read(FTS_ID_REG2, idl, 1);
+}
+
+/* The pair FTS_CHIP_TYPE_MAPPING expects for FTS_CHIP_TYPE = _FT3418. */
+static bool
+ft_id_ok(uint8_t idh, uint8_t idl)
+{
+	return idh == FTS_CHIP_IDH && idl == FTS_CHIP_IDL;
+}
+
+static void
+ft_thread(void *arg, wait_result_t result)
+{
+	uint8_t idh = 0, idl = 0;
+	unsigned boot_try = 0;
+	unsigned itry;
+
+	(void)arg;
+	(void)result;
+
+	printf("SWEET FLEUR TOUCH: starting (MTK I2C @0x%08x, FTS @0x%02x)\n",
+	    I2C_BASE, FTS_ADDR);
+
+	ft.i2c = ml_io_map(I2C_BASE, I2C_SIZE);
+	ft.gpio = ml_io_map(GPIO_BASE, GPIO_SIZE);
+	ft.iocfg = ml_io_map(IOCFG_LM_BASE, IOCFG_LM_SIZE);
+	ft.infracfg = ml_io_map(INFRACFG_BASE, 0x1000u);
+	ft.imp = ml_io_map(IMP_IIC_BASE, 0x1000u);
+	ft.topck = ml_io_map(TOPCK_BASE, 0x1000u);
+	if (ft.i2c == 0 || ft.gpio == 0 || ft.iocfg == 0 || ft.infracfg == 0 ||
+	    ft.imp == 0 || ft.topck == 0) {
+		printf("SWEET FLEUR TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	printf("SWEET FLEUR TOUCH: i2c @0x%llx gpio @0x%llx "
+	    "iocfg @0x%llx\n", (unsigned long long)ft.i2c,
+	    (unsigned long long)ft.gpio, (unsigned long long)ft.iocfg);
+	if (((ft.i2c | ft.gpio | ft.iocfg | ft.infracfg | ft.imp | ft.topck)
+	    >> 48) != 0xffffULL) {
+		printf("SWEET FLEUR TOUCH: mapping is not a kernel address, "
+		    "leaving the hardware alone\n");
+		goto out;
+	}
+
+	/* Before-state: what LK left behind (vendor gpio_init_default). */
+	printf("SWEET FLEUR TOUCH: mode pre 15=0x%x 16=0x%x 58=0x%x "
+	    "144=0x%08x cfg6=0x%08x\n",
+	    (ft_rd(ft.gpio, GPIO_MODE(15)) >> GPIO_MODE_SH(15)) & 0xF,
+	    (ft_rd(ft.gpio, GPIO_MODE(16)) >> GPIO_MODE_SH(16)) & 0xF,
+	    (ft_rd(ft.gpio, GPIO_MODE(58)) >> GPIO_MODE_SH(58)) & 0xF,
+	    ft_rd(ft.gpio, GPIO_MODE(144)), ft_rd(ft.topck, TOP_CLK_CFG_6));
+
+	/* IRQ/RST/AVDD must be plain GPIOs (vendor default: fn 0). */
+	ft_mode(TOUCH_IRQ_GPIO, 0);
+	ft_mode(TOUCH_RST_GPIO, 0);
+	ft_mode(TOUCH_AVDD_GPIO, 0);
+	ft_gpio_dir(TOUCH_IRQ_GPIO, FALSE);
+	ft_gpio_dir(TOUCH_RST_GPIO, TRUE);
+	ft_gpio_dir(TOUCH_AVDD_GPIO, TRUE);
+	ft_gpio_write(TOUCH_RST_GPIO, FALSE);
+	ft_gpio_write(TOUCH_AVDD_GPIO, FALSE);
+
+	ft_clocks_on();
+	ft_pins_i2c();
+
+	printf("SWEET FLEUR TOUCH: mode post 15=0x%x 16=0x%x 58=0x%x "
+	    "144=0x%08x\n",
+	    (ft_rd(ft.gpio, GPIO_MODE(15)) >> GPIO_MODE_SH(15)) & 0xF,
+	    (ft_rd(ft.gpio, GPIO_MODE(16)) >> GPIO_MODE_SH(16)) & 0xF,
+	    (ft_rd(ft.gpio, GPIO_MODE(58)) >> GPIO_MODE_SH(58)) & 0xF,
+	    ft_rd(ft.gpio, GPIO_MODE(144)));
+
+	/*
+	 * Vendor fts_reset_proc(200): reset low 1 ms, high, then wait
+	 * 200 ms for the panel FW to come up.  Our old 5/50 ms sequence
+	 * sampled the chip before it was valid, which is why the id read
+	 * came back as 0xb1 instead of 0x5452.
+	 */
+	ft_gpio_write(TOUCH_AVDD_GPIO, TRUE);
+	ft_wait(10);
+	ft_gpio_write(TOUCH_RST_GPIO, FALSE);
+	ft_wait(1);
+	ft_gpio_write(TOUCH_RST_GPIO, TRUE);
+	ft_wait(200);
+
+	ft_i2c_init_hw();
+	printf("SWEET FLEUR TOUCH: timing=0x%04x ltiming=0x%04x "
+	    "ctl=0x%04x div=0x%04x io=0x%04x intr=0x%04x dbg=0x%04x\n",
+	    ft_rd16(ft.i2c, I2C_TIMING), ft_rd16(ft.i2c, I2C_LTIMING),
+	    ft_rd16(ft.i2c, I2C_CONTROL), ft_rd16(ft.i2c, I2C_CLOCK_DIV),
+	    ft_rd16(ft.i2c, I2C_IO_CONFIG), ft_rd16(ft.i2c, I2C_INTR_STAT),
+	    ft_rd16(ft.i2c, I2C_DEBUGSTAT));
+
+	/*
+	 * Vendor fts_wait_tp_to_valid()/fts_get_ic_information(): read both
+	 * id bytes and retry before deciding the FW is invalid.
+	 */
+	for (itry = 0; itry < 10; ++itry) {
+		if (ft_read_ids(&idh, &idl) == 0 && idh != 0 && idl != 0) {
+			break;
+		}
+		ft_wait(100);
+	}
+	printf("SWEET FLEUR TOUCH: chip ID 0x%02x%02x (expect 0x%02x%02x)%s\n",
+	    idh, idl, FTS_CHIP_IDH, FTS_CHIP_IDL,
+	    ft_id_ok(idh, idl) ? "" : " -- no match");
+
+	if (!ft_id_ok(idh, idl)) {
+		/*
+		 * Exactly what fts_get_ic_information() does when the id
+		 * pair never validates: write fts_hid2std()'s 0xeb 0xaa 0x09
+		 * (HID -> standard I2C) and re-read.
+		 */
+		const uint8_t hid2std[3] = { 0xEB, 0xAA, 0x09 };
+
+		if (ft_i2c_write(hid2std, 3) == 0) {
+			printf("SWEET FLEUR TOUCH: wrote hid2std "
+			    "eb aa 09 (vendor fts_hid2std)\n");
+		} else {
+			printf("SWEET FLEUR TOUCH: hid2std write failed\n");
+		}
+		ft_wait(10);
+		if (ft_read_ids(&idh, &idl) == 0) {
+			printf("SWEET FLEUR TOUCH: chip ID after hid2std "
+			    "0x%02x%02x%s\n", idh, idl,
+			    ft_id_ok(idh, idl) ? " (matched)" : "");
+		}
+	}
+
+	/*
+	 * Re-arm the controller a couple of times: the chip needs its reset
+	 * window and the bus may settle late.  Diagnostics are printed by
+	 * ft_note_fail() on the first failure only.
+	 */
+	while (!ft.dead) {
+		if (boot_try > 0 && (boot_try % 50) == 0 &&
+		    !ft_id_ok(idh, idl)) {
+			uint8_t idh2 = 0, idl2 = 0;
+
+			if (ft_read_ids(&idh2, &idl2) == 0) {
+				idh = idh2;
+				idl = idl2;
+				if (ft_id_ok(idh, idl)) {
+					printf("SWEET FLEUR TOUCH: chip ID "
+					    "0x%02x%02x after %u tries\n",
+					    idh, idl, boot_try);
+				}
+			}
+		}
+		boot_try++;
+		/* Read when the (active-low) INT line asserts, plus every 5th
+		 * poll so a mismapped INT line still gives us data. */
+		if (!ft_gpio_read(TOUCH_IRQ_GPIO) || (boot_try % 5) == 0) {
+			ft_read_points();
+		}
+		ft_wait(10);
+	}
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_fleur_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	kern_return_t kr;
+
+	if (ft.started) {
+		return;
+	}
+	ft.started = true;
+
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET FLEUR TOUCH: disabled (sweettouch=0)\n");
+		return;
+	}
+
+	kr = kernel_thread_start(ft_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET FLEUR TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
